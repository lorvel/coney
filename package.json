{
  "name": "@lorvel/coney",
  "version": "0.3.0",
  "description": "An opinionated RabbitMQ toolkit for Node.js: work queues with broker-held retry ladders and dead-letter queues, publisher confirms, automatic reconnection, graceful drain, and topic pub/sub.",
  "keywords": [
    "rabbitmq",
    "amqp",
    "amqplib",
    "queue",
    "worker",
    "retry",
    "dead-letter",
    "pubsub"
  ],
  "license": "MIT",
  "author": "Tu Tran",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/lorvel/packages/coney.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "typecheck:design": "tsc -p docs/api",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "yarn build",
    "release": "sh scripts/release.sh"
  },
  "peerDependencies": {
    "amqplib": ">=1.1.0 <3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "amqplib": "^2.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "zod": "^4.4.3"
  }
}
